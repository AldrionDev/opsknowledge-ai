# Local development values only. Copy to .env (ignored by Git); never commit real secrets.
# These match the development credentials in compose.yaml.
DATABASE_URL=postgresql+psycopg://opsknowledge:opsknowledge_dev@localhost:5432/opsknowledge

# Server used by the PostgreSQL integration tests. Each test creates and drops its
# own temporary "opsknowledge_test_<id>" database; no other database is touched.
TEST_DATABASE_URL=postgresql+psycopg://opsknowledge:opsknowledge_dev@localhost:5432/postgres

# LLM access (used by LLM features only; ingestion, retrieval and POST /search do
# not need it). Replace the placeholder with a real key in your local .env only.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_RETRIES=2
